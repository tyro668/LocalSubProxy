<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.avora</groupId>
    <artifactId>lmbp-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>lmbp-core</artifactId>
  <name>lmbp-core</name>
  <description>Framework-agnostic LMBP gateway engine (no runtime dependencies beyond the JDK)</description>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/../../../spec/schemas</directory>
        <targetPath>dev/avora/lmbp/schemas</targetPath>
        <includes><include>defs.json</include><include>task.run.payload.json</include><include>hello.json</include><include>models.update.json</include><include>task.done.json</include><include>task.error.json</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables><lmbp.root>${project.basedir}/../../..</lmbp.root></systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
