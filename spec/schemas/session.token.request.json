{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localsubproxy.dev/spec/lsp2/session.token.request.json",
  "title": "session.token.request",
  "description": "device→gateway",
  "type": "object",
  "required": [
    "access_token",
    "proof"
  ],
  "properties": {
    "access_token": {
      "$ref": "defs.json#/$defs/compactJws"
    },
    "proof": {
      "$ref": "defs.json#/$defs/compactJws",
      "description": "Proof JWT, aud lsp2:session.token, ath=SHA-256(new access token)."
    }
  }
}
