{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localsubproxy.dev/spec/lsp2/welcome.json",
  "title": "welcome",
  "description": "gateway→device",
  "type": "object",
  "required": [
    "session_id",
    "heartbeat_seconds",
    "max_frame_bytes",
    "token_expires_at",
    "capabilities"
  ],
  "properties": {
    "session_id": {
      "$ref": "defs.json#/$defs/id"
    },
    "heartbeat_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "max_frame_bytes": {
      "type": "integer",
      "minimum": 65536
    },
    "token_expires_at": {
      "$ref": "defs.json#/$defs/numericDate"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "defs.json#/$defs/capability"
      }
    }
  }
}
