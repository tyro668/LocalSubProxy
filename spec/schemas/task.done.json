{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localsubproxy.dev/spec/lsp2/task.done.json",
  "title": "task.done",
  "description": "device→gateway",
  "type": "object",
  "required": [
    "finish_reason"
  ],
  "properties": {
    "finish_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "examples": [
        "stop",
        "length",
        "content_filter"
      ]
    },
    "usage": {
      "$ref": "defs.json#/$defs/usage"
    }
  }
}
