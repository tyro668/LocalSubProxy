{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localsubproxy.dev/spec/lsp2/defs.json",
  "title": "lsp2 shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._~-]+$",
      "description": "Opaque identifier. Implementations SHOULD use UUIDv7 or ULID, optionally with a type prefix."
    },
    "compactJws": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]*\\.[A-Za-z0-9_-]+$",
      "maxLength": 65536,
      "description": "RFC 7515 compact serialization, base64url without padding."
    },
    "numericDate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799,
      "description": "RFC 7519 NumericDate (seconds since epoch, UTC)."
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S+$"
    },
    "errorCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
      "description": "Stable error code; see docs/protocol-v2.md §9. Unknown codes MUST be treated as non-retryable unless retryable=true."
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "message": {
      "type": "object",
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 1048576
        }
      }
    },
    "usage": {
      "type": "object",
      "required": [
        "prompt_tokens",
        "completion_tokens"
      ],
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "errorBody": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/errorCode"
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        },
        "retryable": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
