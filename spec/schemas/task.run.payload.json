{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localsubproxy.dev/spec/lmbp/task.run.payload.json",
  "title": "task.run.payload",
  "description": "JWS payload of task.run (gateway→device). Either messages (cleartext) or e2ee (sealed request) MUST be present.",
  "type": "object",
  "required": [
    "task_id",
    "iat",
    "exp",
    "nonce",
    "device_id",
    "model"
  ],
  "properties": {
    "task_id": {
      "$ref": "defs.json#/$defs/id"
    },
    "iat": {
      "$ref": "defs.json#/$defs/numericDate"
    },
    "exp": {
      "$ref": "defs.json#/$defs/numericDate"
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "device_id": {
      "$ref": "defs.json#/$defs/id"
    },
    "model": {
      "$ref": "defs.json#/$defs/modelId"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "defs.json#/$defs/message"
      }
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "top_p": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "stop": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "description": "Stop sequences (OpenAI stop / Anthropic stop_sequences)."
    },
    "tools": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "defs.json#/$defs/tool"
      }
    },
    "tool_choice": {
      "oneOf": [
        {
          "enum": [
            "none",
            "auto",
            "required"
          ]
        },
        {
          "type": "object"
        }
      ]
    },
    "blobs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "defs.json#/$defs/blobRef"
      },
      "description": "Blobs delivered by the blob.chunk data frames that follow this task.run (§16.3)."
    },
    "e2ee": {
      "type": "object",
      "required": [
        "blob"
      ],
      "properties": {
        "blob": {
          "$ref": "defs.json#/$defs/id",
          "description": "Blob (media type application/jose) holding the JWE sealed request."
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "messages"
      ]
    },
    {
      "required": [
        "e2ee"
      ]
    }
  ]
}
