{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localsubproxy.dev/spec/lsp2/task.run.payload.json",
  "title": "task.run.payload",
  "description": "JWS payload of task.run (gateway→device)",
  "type": "object",
  "required": [
    "task_id",
    "iat",
    "exp",
    "nonce",
    "device_id",
    "model",
    "messages"
  ],
  "properties": {
    "task_id": {
      "$ref": "defs.json#/$defs/id"
    },
    "iat": {
      "$ref": "defs.json#/$defs/numericDate"
    },
    "exp": {
      "$ref": "defs.json#/$defs/numericDate"
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "device_id": {
      "$ref": "defs.json#/$defs/id"
    },
    "model": {
      "$ref": "defs.json#/$defs/modelId"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "defs.json#/$defs/message"
      }
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    }
  }
}
